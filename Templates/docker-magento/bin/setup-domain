#!/usr/bin/env bash
set -o errexit

[ -z "$1" ] && echo "Please specify a domain name (ex. magento.test)" && exit

DOMAIN=$1

source "$(dirname "$0")/../.env"
BASE_URL="https://${DOMAIN}:${HTTPS_PORT}/"

if ! grep -q "$DOMAIN" /etc/hosts; then
    echo "Your system password is needed to add an entry to /etc/hosts..."
    echo "127.0.0.1 ::1 $DOMAIN" | sudo tee -a /etc/hosts
fi

echo "Set ${BASE_URL} to web/secure/base_url and web/unsecure/base_url"
bin/clinotty bin/magento config:set web/secure/base_url "$BASE_URL"
bin/clinotty bin/magento config:set web/unsecure/base_url "$BASE_URL"

echo "Generating SSL certificate..."
bin/setup-ssl "$DOMAIN"
